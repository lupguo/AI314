#!/bin/sh
# AI314 经验闭环入口（两端 hook 共用）。hook 进程 PATH 常较精简，python3 可能是不含 tomllib 的系统 3.9：
# 依次挑选 ≥3.11 的解释器；都没有则静默退出，绝不让 hook 报错干扰会话。AI314_PYTHON 可显式指定。
DIR=$(cd "$(dirname "$0")" && pwd)
ok() { "$1" -c 'import sys; sys.exit(sys.version_info < (3, 11))' >/dev/null 2>&1; }
if [ -n "${AI314_PYTHON:-}" ]; then
  CANDS="$AI314_PYTHON"
else
  CANDS="python3 python3.15 python3.14 python3.13 python3.12 python3.11 /opt/homebrew/bin/python3 /usr/local/bin/python3"
fi
for p in $CANDS; do
  if ok "$p"; then
    # -I：隔离模式，不读 PYTHONPATH/用户 site，也不把 cwd 加入 sys.path
    exec "$p" -I -c 'import sys; sys.path.insert(0, sys.argv[1]); from lessons import cli; raise SystemExit(cli.main(sys.argv[2:]))' "$DIR" "$@"
  fi
done
exit 0
